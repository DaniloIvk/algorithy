	"outcome_details_blocks_over": [
		{
			"declarations": ["input used", "input optimal", "local usedPlural = used: plural"],
			"selectors": ["usedPlural"],
			"match": {
				"usedPlural=one": "You used {used} block, but you could have used only {optimal}. Try again to simplify your algorithm.",
				"usedPlural=other": "You used {used} blocks, but you could have used only {optimal}. Try again to simplify your algorithm."
			}
		}
	],
	"outcome_details_blocks_perfect": [
		{
			"declarations": ["input used", "local usedPlural = used: plural"],
			"selectors": ["usedPlural"],
			"match": {
				"usedPlural=one": "Perfect! You used {used} block - that is the ideal count for this level.",
				"usedPlural=other": "Perfect! You used {used} blocks - that is the ideal count for this level."
			}
		}
	],
	"outcome_details_blocks_under": [
		{
			"declarations": ["input used", "input optimal", "local usedPlural = used: plural"],
			"selectors": ["usedPlural"],
			"match": {
				"usedPlural=one": "Incredible! You used only {used} block - we thought {optimal} was minimal. You beat our estimate!",
				"usedPlural=other": "Incredible! You used only {used} blocks - we thought {optimal} was minimal. You beat our estimate!"
			}
		}
	],
	"outcome_details_cycles_over": [
		{
			"declarations": ["input used", "input optimal", "local usedPlural = used: plural"],
			"selectors": ["usedPlural"],
			"match": {
				"usedPlural=one": "You used {used} cycle, but the ideal is {optimal}. Try to reduce cycles.",
				"usedPlural=other": "You used {used} cycles, but the ideal is {optimal}. Try to reduce cycles."
			}
		}
	],
	"outcome_details_cycles_over_repetitions": "The solution is correct, but the loop repeats more times than necessary.",
